# Copy to .env and adjust.

# --- application ---------------------------------------------------------
APP_PORT=8080
AUTH_USERNAME=admin
# Leave empty to generate a password on first boot (printed in the logs).
AUTH_PASSWORD=
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

# --- Cap CAPTCHA (docker compose --profile captcha up -d) ----------------
# Dashboard password for the Cap server (>= 12 characters).
CAP_ADMIN_KEY=
# Create a site key once the Cap container is running:
#   ADMIN_KEY=$CAP_ADMIN_KEY ./tools/cap_create_site.sh electricacl
CAP_SITE_KEY=
CAP_SECRET=
# Same-origin mode (recommended): the app proxies the Cap API through /cap/<site>/,
# so Cap does not need a public URL and no CORS rules are involved.
CAP_UPSTREAM=http://cap:3000
# Alternative: point the browser straight at a public Cap instance.
# CAP_API_ENDPOINT=https://cap.example.com/<site-key>/
# When CAP_API_ENDPOINT is set it wins over CAP_UPSTREAM/CAP_SITE_KEY.
