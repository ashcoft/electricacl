# Copy to .env and adjust.

# --- application ---------------------------------------------------------
APP_PORT=8080
AUTH_USERNAME=admin
# Leave empty to generate a password on first boot (printed in the logs).
AUTH_PASSWORD=
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

# --- Cap CAPTCHA (docker compose --profile captcha up -d) ----------------
# Dashboard password for the Cap server (>= 12 characters).
CAP_ADMIN_KEY=
# Site key and secret created in the Cap dashboard at http://localhost:3000.
# CAP_API_ENDPOINT looks like http://localhost:3000/<site-key>/ and must be
# reachable from the browser, so use your public URL in production.
CAP_API_ENDPOINT=
CAP_SECRET=
